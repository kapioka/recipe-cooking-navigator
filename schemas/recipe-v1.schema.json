{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kapioka/recipe-cooking-navigator/schemas/recipe-v1.schema.json",
  "title": "Recipe Cooking Navigator Recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "recipe"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "type": {
      "const": "recipe"
    },
    "recipe": {
      "$ref": "#/$defs/recipe"
    }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "display"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "display": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ingredientUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingredient_id",
        "quantity"
      ],
      "properties": {
        "ingredient_id": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "quantity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "utensil": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "quantity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "reuse_note": {
          "type": "string"
        }
      }
    },
    "prepTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "ingredient_uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ingredientUse"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "instruction",
        "ingredient_uses",
        "done_when",
        "utensil_ids",
        "parallel_tasks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "ingredient_uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ingredientUse"
          }
        },
        "heat": {
          "type": "string",
          "minLength": 1
        },
        "timer_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "done_when": {
          "type": "string",
          "minLength": 1
        },
        "utensil_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parallel_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_preview": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "adjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "action"
      ],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "title",
        "servings",
        "total_time_minutes",
        "estimated_difficulty",
        "ingredients",
        "overview",
        "utensils",
        "preparation",
        "stages",
        "adjustments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "parent_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "servings": {
          "type": "integer",
          "minimum": 1
        },
        "total_time_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "estimated_difficulty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "reason"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        },
        "overview": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "utensils": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/utensil"
          }
        },
        "preparation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prepTask"
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "adjustments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adjustment"
          }
        },
        "storage_note": {
          "type": "string"
        },
        "lunchbox_note": {
          "type": "string"
        },
        "revision_summary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
