{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapioka.github.io/recipe-cooking-navigator/schemas/preference-operation-v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_schema_version",
        "operation_id",
        "base_revision",
        "decided_at",
        "kind",
        "candidate"
      ],
      "properties": {
        "operation_schema_version": {
          "const": "1.0.0"
        },
        "operation_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "base_revision": {
          "type": "integer",
          "minimum": 1
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "kind": {
          "const": "candidate"
        },
        "candidate": {
          "$ref": "preference-candidates-v1.schema.json#/$defs/candidate"
        }
      },
      "allOf": [
        {
          "properties": {
            "candidate": {
              "properties": {
                "status": {
                  "enum": [
                    "accepted",
                    "rejected"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "candidate": {
                "properties": {
                  "status": {
                    "const": "accepted"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "decided_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_schema_version",
        "operation_id",
        "base_revision",
        "decided_at",
        "kind",
        "scope",
        "dimension",
        "direction",
        "declaration"
      ],
      "properties": {
        "operation_schema_version": {
          "const": "1.0.0"
        },
        "operation_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "base_revision": {
          "type": "integer",
          "minimum": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "const": "explicit_preference"
        },
        "scope": {
          "$ref": "cooking-profile-v1.schema.json#/$defs/scope"
        },
        "dimension": {
          "$ref": "cooking-profile-v1.schema.json#/$defs/dimension"
        },
        "direction": {
          "enum": [
            -1,
            1
          ]
        },
        "declaration": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 2000
        }
      }
    }
  ]
}
